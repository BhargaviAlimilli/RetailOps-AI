# Copy to backend/.env; local-only disposable demo database.
RETAILOPS_ENVIRONMENT=development
RETAILOPS_DATABASE_URL=postgresql+psycopg://retailops:retailops_local_only@127.0.0.1:5432/retailops_demo
RETAILOPS_CORS_ORIGINS=["http://localhost:5173"]
RETAILOPS_DATABASE_TIMEOUT_SECONDS=3
# Set a unique local password of 12-256 characters before seeding.
# RETAILOPS_DEMO_PASSWORD=your-unique-local-password
# AI remains disabled until a model and key are explicitly configured and calls authorized.
RETAILOPS_AI_PROVIDER=disabled
RETAILOPS_GEMINI_API_VERSION=v1
RETAILOPS_GEMINI_STREAM_TRANSPORT=json
# RETAILOPS_AI_MODEL=gemini-your-enabled-model-id
# RETAILOPS_GEMINI_API_KEY=set-locally-never-commit
RETAILOPS_AI_TIMEOUT_SECONDS=45
RETAILOPS_AI_MAX_OUTPUT_TOKENS=1024
RETAILOPS_AI_MAX_RETRIES=1
RETAILOPS_AI_MAX_ACTIVE_PER_USER=2
RETAILOPS_AI_MAX_ACTIVE_GLOBAL=4
RETAILOPS_AI_MAX_GENERATIONS_PER_MINUTE=10
RETAILOPS_AI_MAX_GENERATIONS_PER_DAY=100
RETAILOPS_AI_MAX_CONVERSATIONS_PER_USER=100
RETAILOPS_RAG_ENABLED=false
RETAILOPS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RETAILOPS_RAG_MAX_DOCUMENT_CHARACTERS=100000
RETAILOPS_RAG_MAX_DOCUMENTS_PER_USER=50
RETAILOPS_RAG_MAX_QUERIES_PER_DAY=200
RETAILOPS_RAG_MAX_INGESTIONS_PER_DAY=20
